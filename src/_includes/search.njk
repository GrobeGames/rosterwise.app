{# ============================================================
   Site search — self-contained (markup + CSS + JS, no dependencies).
   Include once per page, inside <body>. The nav trigger button lives
   separately in each nav (class="nav-search-btn") and is wired up here
   by class, so all three nav copies (base.njk, index.html,
   start-here/index.html) share this one implementation.

   Index: /search-index.json, generated at build time by
   src/search-index.njk (content pages + every program page).
   It is fetched lazily on first open, then cached in memory.
   ============================================================ #}
<style>
  .nav-search-btn{display:inline-flex;align-items:center;gap:6px;background:transparent;border:1px solid rgba(255,255,255,.22);color:rgba(255,255,255,.72);font-size:13px;font-weight:500;font-family:inherit;padding:6px 12px;border-radius:6px;cursor:pointer;transition:color .2s,border-color .2s}
  .nav-search-btn:hover{color:var(--gold);border-color:rgba(200,164,78,.55)}
  .nav-search-btn svg{flex:0 0 auto}
  .rw-search-kbd{font-size:10px;opacity:.55;border:1px solid currentColor;border-radius:3px;padding:0 4px;line-height:1.5}
  @media(max-width:860px){.rw-search-kbd{display:none}}

  .rw-search-overlay{position:fixed;inset:0;z-index:1000;display:none;background:rgba(10,16,30,.72);backdrop-filter:blur(3px);padding:clamp(16px,8vh,90px) 16px 16px}
  .rw-search-overlay.open{display:block}
  .rw-search-panel{max-width:660px;margin:0 auto;background:#fff;border-radius:14px;box-shadow:0 24px 70px rgba(0,0,0,.45);overflow:hidden;display:flex;flex-direction:column;max-height:min(70vh,620px)}
  .rw-search-head{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid rgba(0,0,0,.09)}
  .rw-search-head svg{flex:0 0 auto;color:#8b8f98}
  #rwSearchInput{flex:1;border:0;outline:0;font-size:17px;font-family:inherit;color:#12203c;background:transparent;min-width:0}
  #rwSearchInput::placeholder{color:#9aa0ab}
  .rw-search-close{background:transparent;border:0;color:#8b8f98;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;padding:4px 8px;border-radius:5px}
  .rw-search-close:hover{background:rgba(0,0,0,.06);color:#12203c}
  .rw-search-results{overflow-y:auto;padding:6px 0 10px}
  .rw-search-group{font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#8b8f98;padding:12px 18px 5px}
  .rw-hit{display:block;padding:9px 18px;text-decoration:none;border-left:3px solid transparent}
  .rw-hit:hover,.rw-hit.sel{background:rgba(200,164,78,.13);border-left-color:var(--gold,#c8a44e)}
  .rw-hit-t{font-size:15px;font-weight:600;color:#12203c;line-height:1.35}
  .rw-hit-d{font-size:12.5px;color:#5c6373;margin-top:2px;line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .rw-hit mark{background:rgba(200,164,78,.34);color:inherit;padding:0 1px;border-radius:2px}
  .rw-search-msg{padding:26px 18px;text-align:center;color:#6b7280;font-size:14px}
  .rw-search-foot{border-top:1px solid rgba(0,0,0,.08);padding:8px 16px;font-size:11px;color:#8b8f98;display:flex;gap:14px;flex-wrap:wrap}
  @media(prefers-reduced-motion:no-preference){.rw-search-panel{animation:rwPop .14s ease-out}@keyframes rwPop{from{transform:translateY(-8px);opacity:.6}to{transform:none;opacity:1}}}
</style>

<div class="rw-search-overlay" id="rwSearchOverlay" role="dialog" aria-modal="true" aria-label="Search RosterWise">
  <div class="rw-search-panel" role="document">
    <div class="rw-search-head">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
      <input id="rwSearchInput" type="search" autocomplete="off" spellcheck="false" placeholder="Search guides, sports, and programs…" aria-label="Search query">
      <button class="rw-search-close" id="rwSearchClose" aria-label="Close search">ESC</button>
    </div>
    <div class="rw-search-results" id="rwSearchResults"></div>
    <div class="rw-search-foot"><span>↑↓ to navigate</span><span>↵ to open</span><span>esc to close</span></div>
  </div>
</div>

<script>
(function () {
  var overlay = document.getElementById('rwSearchOverlay');
  var input = document.getElementById('rwSearchInput');
  var results = document.getElementById('rwSearchResults');
  var closeBtn = document.getElementById('rwSearchClose');
  if (!overlay || !input || !results) return;

  var idx = null, loading = false, sel = -1, hits = [], timer = null;

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function rxEsc(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

  function highlight(text, terms) {
    var out = esc(text);
    for (var i = 0; i < terms.length; i++) {
      if (terms[i].length < 2) continue;
      out = out.replace(new RegExp('(' + rxEsc(terms[i]) + ')', 'ig'), '<mark>$1</mark>');
    }
    return out;
  }

  function load() {
    if (idx || loading) return;
    loading = true;
    render('Loading search…');
    fetch('/search-index.json')
      .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
      .then(function (data) { idx = data; loading = false; run(); })
      .catch(function () { loading = false; render('Search is unavailable right now. Please try again.'); });
  }

  function score(item, terms) {
    var t = item.t.toLowerCase(), d = (item.d || '').toLowerCase(), b = (item.b || '').toLowerCase();
    var total = 0;
    for (var i = 0; i < terms.length; i++) {
      var q = terms[i], s = 0;
      if (t === q) s = 200;
      else if (t.indexOf(q) === 0) s = 120;
      else if (t.indexOf(' ' + q) > -1) s = 90;
      else if (t.indexOf(q) > -1) s = 60;
      if (!s && d.indexOf(q) > -1) s = 24;
      if (!s && b.indexOf(q) > -1) s = 10;
      if (!s) return 0;            // every term must match somewhere
      total += s;
    }
    if (item.k === 'page') total += 6; // nudge guides above program pages on ties
    return total;
  }

  function run() {
    var raw = input.value.trim();
    if (!raw) { results.innerHTML = ''; hits = []; sel = -1; return; }
    if (!idx) { load(); return; }
    var terms = raw.toLowerCase().split(/\s+/).filter(Boolean);

    var scored = [];
    for (var i = 0; i < idx.length; i++) {
      var s = score(idx[i], terms);
      if (s > 0) scored.push({ item: idx[i], s: s });
    }
    scored.sort(function (a, b) { return b.s - a.s || a.item.t.length - b.item.t.length; });
    hits = scored.slice(0, 30).map(function (x) { return x.item; });
    sel = hits.length ? 0 : -1;

    if (!hits.length) { render('No results for &ldquo;' + esc(raw) + '&rdquo;.'); return; }

    var html = '', lastKind = '';
    for (var j = 0; j < hits.length; j++) {
      var h = hits[j];
      if (h.k !== lastKind) {
        html += '<div class="rw-search-group">' + (h.k === 'program' ? 'Programs' : 'Guides &amp; Pages') + '</div>';
        lastKind = h.k;
      }
      html += '<a class="rw-hit' + (j === sel ? ' sel' : '') + '" href="' + esc(h.u) + '" data-i="' + j + '">' +
        '<div class="rw-hit-t">' + highlight(h.t, terms) + '</div>' +
        (h.d ? '<div class="rw-hit-d">' + highlight(h.d, terms) + '</div>' : '') +
        '</a>';
    }
    results.innerHTML = html;
    results.scrollTop = 0;
  }

  function render(msg) { results.innerHTML = '<div class="rw-search-msg">' + msg + '</div>'; hits = []; sel = -1; }

  function move(d) {
    if (!hits.length) return;
    sel = (sel + d + hits.length) % hits.length;
    var nodes = results.querySelectorAll('.rw-hit');
    for (var i = 0; i < nodes.length; i++) nodes[i].classList.toggle('sel', i === sel);
    if (nodes[sel]) nodes[sel].scrollIntoView({ block: 'nearest' });
  }

  function open() {
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    input.focus();
    input.select();
    load();
  }
  function close() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  var btns = document.querySelectorAll('.nav-search-btn');
  for (var i = 0; i < btns.length; i++) {
    btns[i].addEventListener('click', function (e) { e.preventDefault(); open(); });
  }
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('mousedown', function (e) { if (e.target === overlay) close(); });

  input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 90); });
  input.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') { if (hits[sel]) { e.preventDefault(); window.location.href = hits[sel].u; } }
    else if (e.key === 'Escape') { close(); }
  });
  document.addEventListener('keydown', function (e) {
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); open(); }
    else if (e.key === 'Escape' && overlay.classList.contains('open')) { close(); }
    else if (e.key === '/' && !overlay.classList.contains('open')) {
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') { e.preventDefault(); open(); }
    }
  });
})();
</script>
