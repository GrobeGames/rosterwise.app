---
structured_data_type: article
---
{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | jsonLd | safe }},
  "description": {{ description | jsonLd | safe }},
  "datePublished": "{{ date | dateISO }}",
  "dateModified": "{{ date | dateISO }}",
  "author": {
    "@type": "Person",
    "name": {{ author | default('RosterWise Team') | jsonLd | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "Grobe Games LLC",
    "logo": {
      "@type": "ImageObject",
      "url": "https://rosterwise.app/assets/rosterwise-banner-hero.png"
    }
  },
  "mainEntityOfPage": "https://rosterwise.app{{ page.url }}",
  "image": "https://rosterwise.app/assets/rosterwise-og-banner.jpg"
}
</script>
{% endblock %}

{% block content %}
<div class="content-layout">

  {% include "sidebar.njk" %}

<article class="content-page">

  {% if breadcrumbs %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {% for crumb in breadcrumbs %}
      <li>
        {% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.text }}</a>
        {% else %}<span aria-current="page">{{ crumb.text }}</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <header class="content-header">
    <h1>{{ title }}</h1>
    <p class="content-meta">
      {% if author %}By {{ author }} &middot; {% endif %}
      <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
      &middot; {{ content | readingTime }}
    </p>
  </header>

  <div class="content-body">
    {{ content | safe }}
  </div>

  {% if related %}
  <section class="related-guides">
    <h2>Related Posts &amp; Guides</h2>
    <div class="related-grid">
      {% for item in related %}
      <div class="related-card{% if item.status == 'coming-soon' %} coming-soon{% endif %}">
        {% if item.status == 'coming-soon' %}
        <span class="related-badge">Coming Soon</span>
        <span class="related-title">{{ item.title }}</span>
        {% else %}
        <a href="{{ item.url }}" class="related-link">{{ item.title }}</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if cta %}
  <section class="content-cta">
    {% include "app-logos.njk" %}
    <h2>{{ cta.heading }}</h2>
    <p>{{ cta.text }}</p>
    {% if cta.price %}<p class="content-cta-price">{{ cta.price }}</p>{% endif %}
    {# Primary CTA (hybrid, mirrors content.njk): the sport is resolved from
       the URL via apps.json and is AUTHORITATIVE — legacy per-page
       cta.button_url values are unreliable (stale copy-paste pointed the
       volleyball post at the soccer app), so they are ignored when a sport
       can be derived. button_url is honored only on posts with no derivable
       sport; otherwise fall through to the /app/ hub. #}
    {% set ctaSport = page.url | sportForUrl %}
    {% if ctaSport %}
      {% set ctaUrl = ctaSport.appStoreUrl %}
      {% set ctaText = 'Download RosterWise ' + ctaSport.name + ' on the App Store →' %}
    {% elif cta.button_url %}
      {% set ctaUrl = cta.button_url %}
      {% set ctaText = cta.button_text | default('Download on the App Store →') %}
    {% else %}
      {% set ctaUrl = apps.hubUrl %}
      {% set ctaText = cta.button_text | default('See the RosterWise apps →') %}
    {% endif %}
    <a href="{{ ctaUrl }}" class="content-cta-btn" {% if 'apple.com' in ctaUrl %}target="_blank" rel="noopener"{% endif %}>{{ ctaText }}</a>
    {% if ctaSport %}
    <p style="margin-top: 12px; font-size: 13px; color: rgba(0,0,0,0.5);">Learn more about <a href="{{ ctaSport.downloadPage }}" style="color: var(--gold-dark);">RosterWise {{ ctaSport.name }}</a> &middot; <a href="/roster-intelligence/" style="color: var(--gold-dark);">our methodology</a>.</p>
    {% endif %}
  </section>
  {% else %}
  <section class="content-cta">
    {% include "app-logos.njk" %}
    <h2>See how RosterWise helps your family</h2>
    <p>Deep roster analysis for every NCAA and NAIA program &mdash; position depth, class-year gaps, recruiting patterns, and personalized fit scoring.</p>
    <a href="/app/" class="content-cta-btn">See how RosterWise&trade; helps &rarr;</a>
  </section>
  {% endif %}

  <div class="content-byline">
    <p>Written by {{ author | default('the RosterWise team') }} &mdash; Grobe Games LLC</p>
  </div>

</article>
</div>
{% endblock %}
