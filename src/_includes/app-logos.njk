{# ============================================================
   Shared app-logo block for CTA sections (dark navy background).
   Data-driven from src/_data/apps.json via the `sportForUrl` filter.
   Hybrid model: the icon links to the on-site per-sport download page
   (/<sport>/app/); the App Store link is the primary button rendered by
   the surrounding CTA (content.njk / hub.njk).
     - On a sport page (/soccer/, /wrestling/, …): that sport's logo → its
       on-site download page.
     - On sport-agnostic pages (/guide/, /faq/, /blog/, …): every live
       sport's logo, each → its on-site download page.
   Add or change a sport in apps.json — never here.
   ============================================================ #}
{% set currentSport = page.url | sportForUrl %}
{% if currentSport %}
  <div style="margin-bottom: 24px;">
    <a href="{{ currentSport.downloadPage }}" style="display: inline-block; text-align: center; text-decoration: none;">
      <img src="{{ currentSport.logo }}" alt="RosterWise {{ currentSport.name }} App" width="140" height="140" style="border-radius: 18px; box-shadow: 0 4px 16px rgba(0,0,0,0.25);" loading="lazy">
      <div style="margin-top: 10px; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold);">Available Now</div>
      <div style="font-size: 10px; color: rgba(255,255,255,0.5); margin-top: 2px;">{{ currentSport.subtext }}</div>
    </a>
  </div>
{% else %}
  <div style="display: flex; justify-content: center; gap: 28px; margin-bottom: 24px; flex-wrap: wrap;">
  {% for s in apps.sports %}{% if s.live %}
    <a href="{{ s.downloadPage }}" style="text-align: center; text-decoration: none;">
      <img src="{{ s.logo }}" alt="RosterWise {{ s.name }}" width="120" height="120" style="border-radius: 18px; box-shadow: 0 4px 16px rgba(0,0,0,0.25);" loading="lazy">
      <div style="margin-top: 8px; font-size: 9px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gold);">Available Now</div>
      <div style="font-size: 9px; color: rgba(255,255,255,0.45); margin-top: 2px;">{{ s.subtext }}</div>
    </a>
  {% endif %}{% endfor %}
  </div>
{% endif %}
