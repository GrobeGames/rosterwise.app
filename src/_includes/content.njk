---
structured_data_type: article
---
{% extends "base.njk" %}

{% block content %}
<div class="content-layout">

  {% include "sidebar.njk" %}

<article class="content-page">

  {% if breadcrumbs %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {% for crumb in breadcrumbs %}
      <li>
        {% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.text }}</a>
        {% else %}<span aria-current="page">{{ crumb.text }}</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <header class="content-header">
    <h1>{{ title }}</h1>
    {% if date %}
    <p class="content-meta">
      Last updated <time datetime="{{ date | dateISO }}">{{ date | dateDisplay }}</time>
      &middot; {{ content | readingTime }}
    </p>
    {% endif %}
  </header>

  {% if summary %}
  <div class="summary-box">
    <p>{{ summary }}</p>
  </div>
  {% endif %}

  <div class="content-body">
    {{ content | safe }}
  </div>

  {% if related %}
  <section class="related-guides">
    <h2>Related Guides</h2>
    <div class="related-grid">
      {% for item in related %}
      <div class="related-card{% if item.status == 'coming-soon' %} coming-soon{% endif %}">
        {% if item.status == 'coming-soon' %}
        <span class="related-badge">Coming Soon</span>
        <span class="related-title">{{ item.title }}</span>
        {% else %}
        <a href="{{ item.url }}" class="related-link">{{ item.title }}</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if cta %}
  <section class="content-cta">
    {% include "app-logos.njk" %}
    <h2>{{ cta.heading }}</h2>
    <p>{{ cta.text }}</p>
    {% if cta.price %}<p class="content-cta-price">{{ cta.price }}</p>{% endif %}
    {# Primary CTA (hybrid): App Store link. On a sport page the sport is
       resolved from the URL via apps.json and is AUTHORITATIVE — legacy
       per-page cta.button_url values are unreliable (stale copy-paste points
       many volleyball pages at the soccer app, and wrestling/lacrosse pages at
       /app/), so they are ignored there. button_url is honored only on
       sport-agnostic pages, where there is no sport to derive. #}
    {% set ctaSport = page.url | sportForUrl %}
    {% if ctaSport %}
      {% set ctaUrl = ctaSport.appStoreUrl %}
      {% set ctaText = 'Download RosterWise ' + ctaSport.name + ' on the App Store →' %}
    {% elif cta.button_url %}
      {% set ctaUrl = cta.button_url %}
      {% set ctaText = cta.button_text | default('Download on the App Store →') %}
    {% else %}
      {% set ctaUrl = apps.hubUrl %}
      {% set ctaText = cta.button_text | default('See the RosterWise apps →') %}
    {% endif %}
    <a href="{{ ctaUrl }}" class="content-cta-btn" {% if 'apple.com' in ctaUrl %}target="_blank" rel="noopener"{% endif %}>{{ ctaText }}</a>
    {% if ctaSport %}
    <p style="margin-top: 12px; font-size: 13px; color: rgba(0,0,0,0.5);">Learn more about <a href="{{ ctaSport.downloadPage }}" style="color: var(--gold-dark);">RosterWise {{ ctaSport.name }}</a> &middot; <a href="/roster-intelligence/" style="color: var(--gold-dark);">our methodology</a>.</p>
    {% else %}
    <p style="margin-top: 12px; font-size: 13px; color: rgba(0,0,0,0.5);">Learn more about our <a href="/roster-intelligence/" style="color: var(--gold-dark);">roster intelligence methodology</a>.</p>
    {% endif %}
  </section>
  {% endif %}

  {% if sources %}
  <section class="sources-section">
    <h3>Sources &amp; References</h3>
    <ol class="sources-list">
      {% for source in sources %}
      <li>{{ source | safe }}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <div class="content-byline">
    <p>RosterWise &mdash; Grobe Games LLC</p>
  </div>

</article>
</div><!-- .content-layout -->
{% endblock %}
