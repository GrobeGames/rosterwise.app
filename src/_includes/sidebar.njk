<!-- Guide sidebar navigation -->
<aside class="guide-sidebar" id="guideSidebar">
  <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle guide navigation">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
    <span>Guide Navigation</span>
  </button>
  <nav class="sidebar-nav" id="sidebarNav">

    <!-- ===== START HERE (onboarding pin) ===== -->
    <a href="/start-here/" class="sidebar-start">
      <span class="sidebar-start-ico">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
      </span>
      <span class="sidebar-start-txt"><b>New to recruiting?</b><span>Start Here &rarr;</span></span>
    </a>

    <!-- ===== RECRUITING GUIDES (universal, grouped by topic) ===== -->
    <div class="sidebar-section">
      <div class="sidebar-group" data-sidebar-group="guides">
        <button class="sidebar-group-toggle" aria-expanded="false">
          <span class="sidebar-grp-label">
            <span class="sidebar-grp-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
            <span class="sidebar-grp-name">Recruiting Guides<small>For every sport</small></span>
          </span>
          <span class="sidebar-chevron">&#9654;</span>
        </button>
        {# Guide list is generated from src/_data/guideNav.js — the single
           source of truth shared with the /guide/ index cards. Add new guides
           there, not here. #}
        <ul>
          <li><a href="/guide/">All Guides</a></li>
          {% for group in guideNav %}
          <li class="sidebar-subheader">{{ group.heading }}</li>
          {% for item in group.children %}
          <li><a href="{{ item.url }}">{{ item.label or item.title }}</a></li>
          {% endfor %}
          {% endfor %}
        </ul>
      </div>
    </div>

    <div class="sidebar-divider"></div>

    {# ===== SPORTS =====
       Generated from src/_data/sportNav.json, one entry per sport (a new sport adds
       an entry there, not a block of markup here). The sport the reader is in comes
       first; the script below opens the current page's groups. #}
    {%- set navSport = page.url.split('/')[1] if (page and page.url) else '' %}
    {%- macro sportSection(sp) %}
    <!-- ===== {{ sp.name | upper }} ===== -->
    <div class="sidebar-section">
      <div class="sidebar-group sidebar-sport" data-sidebar-group="{{ sp.slug }}">
        <div class="sidebar-group-header">
          <a href="{{ sp.hub }}" class="sidebar-sport-link">
            <img class="sidebar-sport-ico" src="{{ sp.logo }}" alt="" width="22" height="22" loading="lazy">
            <span class="sidebar-sport-name">{{ sp.name }}<small>{{ sp.subtitle | safe }}</small></span>
          </a>
          <button class="sidebar-group-toggle sidebar-chev-btn" aria-expanded="false" aria-label="Expand {{ sp.name }}">
            <span class="sidebar-chevron">&#9654;</span>
          </button>
        </div>
        <ul>
          {%- for g in sp.groups %}
          <li class="sidebar-group" data-sidebar-group="{{ g.key }}">
            <button class="sidebar-group-toggle" aria-expanded="false"><span>{{ g.label | safe }}</span><span class="sidebar-chevron">&#9654;</span></button>
            <ul>
              {%- for l in g.links %}
              <li><a href="{{ l.href }}">{{ l.label | safe }}</a></li>
              {%- endfor %}
            </ul>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </div>

    <div class="sidebar-divider"></div>
    {%- endmacro %}
    {%- for sp in sportNav %}{% if sp.slug == navSport %}{{ sportSection(sp) }}{% endif %}{% endfor %}
    {%- for sp in sportNav %}{% if sp.slug != navSport %}{{ sportSection(sp) }}{% endif %}{% endfor %}

    <!-- ===== FAQ & BLOG (bottom) ===== -->
    <div class="sidebar-section sidebar-section--secondary">
      <a href="/faq/" class="sidebar-standalone-link">FAQ</a>
      <div class="sidebar-group" data-sidebar-group="blog">
        <button class="sidebar-group-toggle" aria-expanded="false">
          <span>Blog</span>
          <span class="sidebar-chevron">&#9654;</span>
        </button>
        <ul>
          <li><a href="/blog/">All Posts</a></li>
          <li><a href="/blog/how-to-read-a-college-soccer-roster/">How to Read a Roster</a></li>
        </ul>
      </div>
    </div>

    <div class="sidebar-cta">
      <a href="/app/">Get RosterWise&trade; &rarr;</a>
    </div>
  </nav>
</aside>

<script>
  // Sidebar toggle for mobile
  const sidebarToggle = document.getElementById('sidebarToggle');
  const sidebarNav = document.getElementById('sidebarNav');
  if (sidebarToggle && sidebarNav) {
    sidebarToggle.addEventListener('click', () => {
      sidebarNav.classList.toggle('open');
      sidebarToggle.classList.toggle('open');
    });
  }

  // Sport-level groups that should accordion (collapse siblings when one opens)
  const sportGroups = [{% for sp in sportNav %}'{{ sp.slug }}', {% endfor %}];

  // Find the toggle that belongs directly to a group (handles both the sport
  // header pattern — toggle nested in .sidebar-group-header — and plain groups).
  function ownToggle(group) {
    return group.querySelector(':scope > .sidebar-group-header > .sidebar-group-toggle')
        || group.querySelector(':scope > .sidebar-group-toggle');
  }

  document.querySelectorAll('.sidebar-group-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.closest('.sidebar-group');
      const groupId = group.dataset.sidebarGroup;
      const isExpanded = group.classList.contains('expanded');

      // If this is a top-level sport group, collapse other sport groups
      if (sportGroups.includes(groupId) && !isExpanded) {
        sportGroups.forEach(id => {
          if (id !== groupId) {
            const other = document.querySelector(`[data-sidebar-group="${id}"]`);
            if (other) {
              other.classList.remove('expanded');
              const otherToggle = ownToggle(other);
              if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
            }
          }
        });
      }

      group.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', !isExpanded);
    });
  });

  // Highlight current page and auto-expand its parent sections
  const currentPath = window.location.pathname;
  document.querySelectorAll('.sidebar-nav a').forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
      // Walk up and expand all parent groups
      let el = link.closest('.sidebar-group');
      while (el) {
        el.classList.add('expanded');
        const toggle = ownToggle(el);
        if (toggle) toggle.setAttribute('aria-expanded', 'true');
        el = el.parentElement ? el.parentElement.closest('.sidebar-group') : null;
      }
    }
  });
</script>
