{% extends "base.njk" %}

{% block content %}
<div class="content-layout">

  {% include "sidebar.njk" %}

<div class="hub-page">

  {% if breadcrumbs %}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {% for crumb in breadcrumbs %}
      <li>
        {% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.text }}</a>
        {% else %}<span aria-current="page">{{ crumb.text }}</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}

  <header class="hub-header">
    <h1>{{ title }}</h1>
  </header>

  <div class="hub-intro">
    {{ content | safe }}
  </div>

  {% if childGroups %}
  {% for group in childGroups %}
  <section class="hub-children-group">
    <h2 class="hub-group-heading">{{ group.heading }}</h2>
    <div class="hub-children">
      {% for child in group.children %}
      <div class="hub-card{% if child.status == 'coming-soon' %} hub-card--coming{% endif %}">
        {% if child.status == 'coming-soon' %}
        <span class="hub-card-badge">Coming Soon</span>
        {% endif %}
        <h3>
          {% if child.status != 'coming-soon' %}
          <a href="{{ child.url }}">{{ child.title }}</a>
          {% else %}
          {{ child.title }}
          {% endif %}
        </h3>
        {% if child.summary %}<p>{{ child.summary }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
  {% elif children %}
  <section class="hub-children">
    {% for child in children %}
    <div class="hub-card{% if child.status == 'coming-soon' %} hub-card--coming{% endif %}">
      {% if child.status == 'coming-soon' %}
      <span class="hub-card-badge">Coming Soon</span>
      {% endif %}
      <h3>
        {% if child.status != 'coming-soon' %}
        <a href="{{ child.url }}">{{ child.title }}</a>
        {% else %}
        {{ child.title }}
        {% endif %}
      </h3>
      {% if child.summary %}<p>{{ child.summary }}</p>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section class="hub-cta">
    {% include "app-logos.njk" %}
    <h2>Find your athlete&rsquo;s best-fit programs</h2>
    <p>RosterWise&trade; analyzes every roster at every NCAA and NAIA program &mdash; position depth, recruiting patterns, international composition, and more &mdash; so families can target the right schools with confidence.</p>
    {% if page.url and '/soccer/' in page.url %}
    <a href="https://apps.apple.com/us/app/rosterwise-soccer/id6763959341" class="hub-cta-btn" target="_blank" rel="noopener">Download RosterWise&trade; Soccer on the App Store &rarr;</a>
    {% elif page.url and '/volleyball/' in page.url %}
    <a href="https://apps.apple.com/us/app/rosterwise-volleyball/id6774745522" class="hub-cta-btn" target="_blank" rel="noopener">Download RosterWise&trade; Volleyball on the App Store &rarr;</a>
    {% else %}
    <a href="/app/" class="hub-cta-btn">See how RosterWise&trade; helps &rarr;</a>
    {% endif %}
  </section>

</div>
</div><!-- .content-layout -->
{% endblock %}
