/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Client-side search index — fetched by the search box, not a page to index
/search-index.json
  X-Robots-Tag: noindex

# App Preview web copies and posters: the release is in each file name, so a
# file never changes once published (src/_data/previews.json points at them)
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# The Cloudflare Pages production host serves the same build as rosterwise.app
# and was being indexed in its place. A rule with a full URL matches that host
# only, so rosterwise.app never receives this header. Preview deployments
# (<hash>.rosterwise-app.pages.dev) already get noindex from Cloudflare.
https://rosterwise-app.pages.dev/*
  X-Robots-Tag: noindex
